---
/** Полоса дорожки: линии sky на night, стартовая черта и крупные цифры Unbounded 800. */
interface Stat {
  value: string;
  label: string;
  accent?: boolean;
}
interface Props {
  label: string;
  stats: Stat[];
}
const { label, stats } = Astro.props;
---

<section class="band" aria-label={label}>
  <svg class="band__lines" viewBox="0 0 1440 260" preserveAspectRatio="none" aria-hidden="true">
    <g stroke="#8FD0FF" stroke-width="2"><path d="M0 65 H1440"></path><path d="M0 130 H1440"></path><path d="M0 195 H1440"></path><path d="M0 258 H1440"></path></g>
    <rect x="120" y="0" width="10" height="260" fill="#F3F5F8"></rect>
  </svg>
  <dl class="band__in wrap">
    {stats.map((s) => (
      <div class="band__stat">
        <dt class="band__label">{s.label}</dt>
        <dd class:list={['band__value', { 'band__value--accent': s.accent }]}>{s.value}</dd>
      </div>
    ))}
  </dl>
</section>

<style>
  .band { position: relative; overflow: hidden; border-top: 3px solid var(--sky); }
  .band__lines { position: absolute; inset: 0; width: 100%; height: 100%; }
  .band__in { position: relative; margin-block: 0; padding-block: 40px; padding-inline-start: max(150px, 12vw); display: flex; flex-wrap: wrap; gap: 28px 56px; align-items: flex-end; }
  .band__stat { display: flex; flex-direction: column-reverse; }
  .band__value { margin: 0; font: 800 clamp(52px, 5.6vw, 84px) / 0.92 var(--font-display); letter-spacing: -0.04em; }
  .band__value--accent { color: var(--sky); }
  .band__label { margin-top: 10px; font: 500 13px/1.3 var(--font-data); letter-spacing: 0.08em; text-transform: uppercase; color: var(--sky); }
  @media (max-width: 640px) {
    .band__in { padding-inline-start: 56px; gap: 24px 32px; }
    .band__lines rect { x: 28; }
  }
</style>
