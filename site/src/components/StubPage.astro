---
import Base from '../layouts/Base.astro';
interface Props {
  title: string;
  label: string;
  text: string;
}
const { title, label, text } = Astro.props;
---

<Base title={title} headerOnNight={false}>
  <section class="stub wrap">
    <span class="label">{label}</span>
    <h1 class="stub__title">{title}</h1>
    <p class="stub__text">{text}</p>
    <a href="/" class="stub__back">← На главную</a>
  </section>
</Base>

<style>
  .stub { padding-block: 72px 120px; display: flex; flex-direction: column; gap: 16px; align-items: flex-start; min-height: 50vh; }
  .stub__title { margin: 0; font: 700 clamp(40px, 6vw, 76px) / 0.98 var(--font-display); letter-spacing: 0.005em; text-transform: uppercase; }
  .stub__text { margin: 0; max-width: 560px; font-size: 18px; color: var(--ink-muted); }
  .stub__back { display: inline-flex; align-items: center; min-height: 44px; font-weight: 600; }
</style>
