---
interface Props {
  width?: number;
  /** Подпись для скринридера; `decorative` прячет логотип, когда рядом уже есть ссылка с названием. */
  decorative?: boolean;
}
const { width = 176, decorative = false } = Astro.props;
const height = Math.round((width * 300) / 760);
---

<svg
  width={width}
  height={height}
  viewBox="0 0 760 300"
  role={decorative ? undefined : 'img'}
  aria-label={decorative ? undefined : 'Hybrid Training Russia'}
  aria-hidden={decorative ? 'true' : undefined}
>
  <rect x="6" y="6" width="748" height="288" rx="144" fill="none" stroke="#8FD0FF" stroke-width="8"></rect>
  <rect x="28" y="28" width="704" height="244" rx="122" fill="none" stroke="#8FD0FF" stroke-width="3"></rect>
  <rect x="48" y="48" width="664" height="204" rx="102" fill="none" stroke="#8FD0FF" stroke-width="3"></rect>
  <rect x="68" y="68" width="624" height="164" rx="82" fill="#1D46E8"></rect>
  <text x="380" y="146" text-anchor="middle" font-family="Unbounded, 'Arial Black', sans-serif" font-weight="700" font-size="40" letter-spacing="-0.5" fill="#FFFFFF">HYBRID TRAINING</text>
  <text x="380" y="198" text-anchor="middle" font-family="Unbounded, 'Arial Black', sans-serif" font-weight="700" font-size="40" letter-spacing="6" fill="#8FD0FF">RUSSIA</text>
</svg>
