---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  href: string;
  rubric: string;
  title: string;
  /** Обложка статьи; без неё карточка на ночном фоне. */
  cover?: ImageMetadata;
  /** Подпись-заглушка на месте фото, пока своих снимков нет. */
  photoNote?: string;
  readingMin: number;
}
const { href, rubric, title, cover, photoNote, readingMin } = Astro.props;
---

<a href={href} class="card">
  <div class="card__cover">
    {cover ? <Image class="card__img" src={cover} alt="" widths={[300, 600]} sizes="(max-width: 700px) 100vw, 33vw" /> : null}
    <span class="card__rubric">{rubric}</span>
    {photoNote ? <span class="card__note">[Фото: {photoNote}]</span> : null}
  </div>
  <h3 class="card__title">{title}</h3>
  <span class="card__meta">{readingMin} мин чтения</span>
</a>

<style>
  .card { flex: 1 1 300px; min-width: 0; display: flex; flex-direction: column; gap: 12px; color: var(--ink); text-decoration: none; }
  .card:hover { color: var(--ink); }
  .card:hover .card__title { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 4px; }
  .card__cover { position: relative; overflow: hidden; aspect-ratio: 4 / 5; border-radius: 28px; background: var(--night); display: flex; flex-direction: column; justify-content: space-between; padding: 18px; }
  .card__cover :global(.card__img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .card__cover:has(.card__img)::after { content: ''; position: absolute; inset: 0; background: linear-gradient(to bottom, rgba(21, 24, 30, 0.45), rgba(21, 24, 30, 0) 40%); }
  .card__rubric, .card__note { position: relative; z-index: 1; }
  .card__rubric { align-self: flex-start; padding: 4px 12px 5px; border-radius: 999px; background: var(--sky); color: var(--night); font-weight: 600; font-size: 13px; }
  .card__note { color: var(--on-night-muted); font-weight: 500; font-size: 13px; }
  .card__title { margin: 0; font: 600 21px/1.2 var(--font-display); }
  .card__meta { color: var(--ink-muted); font-size: 13px; }
</style>
