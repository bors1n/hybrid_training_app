---
/** SPLAV: «A» собрана из двух половин слитка (кобальт и голубой). */
interface Props {
  size?: number;
}
const { size = 44 } = Astro.props;
---

<span class="wordmark" style={`font-size:${size}px`} role="img" aria-label="SPLAV">
  <span aria-hidden="true">SPL</span><svg width={size * 0.68} height={size * 0.73} viewBox="0 0 60 64" aria-hidden="true" class="wordmark__a"><polygon points="0,64 16,64 29,6 29,0 22,0" fill="#1D46E8"></polygon><polygon points="60,64 44,64 31,6 31,0 38,0" fill="#3091D8"></polygon></svg><span aria-hidden="true">V</span>
</span>

<style>
  .wordmark { display: inline-flex; align-items: baseline; font: 700 1em/1 var(--font-display); letter-spacing: 0.01em; }
  .wordmark__a { margin: 0 2px; align-self: center; }
</style>
