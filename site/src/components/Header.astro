---
import { NAV, SITE } from '../config.ts';
import Button from './Button.astro';
import HtrLogo from './HtrLogo.astro';
import InstagramIcon from './InstagramIcon.astro';

interface Props {
  /** Путь текущей страницы — для подсветки пункта меню. */
  current?: string;
}
const { current = '' } = Astro.props;
const active = (href: string): boolean => current === href || (href !== '/' && current.startsWith(href));
---

<header class="head wrap">
  <a href="/" class="head__logo" aria-label="Hybrid Training Russia, на главную"><HtrLogo decorative /></a>
  <nav aria-label="Разделы" class="head__nav">
    {NAV.map((item) => <a href={item.href} aria-current={active(item.href) ? 'page' : undefined}>{item.label}</a>)}
  </nav>
  <Button href={SITE.instagramUrl} variant="sky" class="head__cta"><InstagramIcon />Инстаграм</Button>
</header>

<style>
  .head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px 32px; padding-block: 20px; color: var(--on-night); }
  .head__logo { display: flex; }
  .head__nav { display: flex; flex-wrap: wrap; gap: 8px 28px; font-weight: 500; font-size: 16px; }
  .head__nav a { color: var(--on-night); text-decoration: none; min-height: 44px; display: inline-flex; align-items: center; border-bottom: 2px solid transparent; }
  .head__nav a:hover { color: var(--sky); }
  .head__nav a[aria-current='page'] { border-bottom-color: var(--sky); }
  .head :global(.head__cta) { min-height: 44px; padding: 0 22px; font-size: 15px; }
  @media (max-width: 640px) {
    .head { gap: 12px 16px; }
    .head__nav { order: 3; width: 100%; gap: 4px 20px; }
  }
</style>
