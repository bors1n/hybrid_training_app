---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE } from '../config.ts';

interface Props {
  title?: string;
  description?: string;
  /** На главной шапка лежит на ночном первом экране, на остальных страницах — на собственной ночной полосе. */
  headerOnNight?: boolean;
}
const { title, description = 'Зал, бег и функциональные комплексы в одной программе.', headerOnNight = true } = Astro.props;
const fullTitle = title ? `${title} — ${SITE.name}` : `${SITE.name}: ${SITE.tagline.toLowerCase()}`;
const path = Astro.url.pathname;
---

<!doctype html>
<html lang="ru" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#15181E" />
    <title>{fullTitle}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <a class="skip" href="#content">К содержимому</a>
    {
      headerOnNight ? (
        <div class="night-top">
          <Header current={path} />
          <slot name="hero" />
        </div>
      ) : (
        <div class="night-top"><Header current={path} /></div>
      )
    }
    <main id="content"><slot /></main>
    <Footer />
    <script>
      import { REVEAL_SELECTOR, revealDelay } from '../lib/reveal.ts';

      // Плавное появление блоков при прокрутке. Любая неудача (нет IntersectionObserver, ошибка) оставляет страницу видимой.
      const root = document.documentElement;
      const calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!calm && 'IntersectionObserver' in window) {
        try {
          const items = [...document.querySelectorAll<HTMLElement>(REVEAL_SELECTOR)];
          const seen = new Map<Element, number>();
          for (const el of items) {
            const siblings = el.parentElement ? [...el.parentElement.children].filter((c) => items.includes(c as HTMLElement)) : [];
            seen.set(el, siblings.indexOf(el));
          }
          const io = new IntersectionObserver(
            (entries) => {
              for (const entry of entries) {
                if (!entry.isIntersecting) continue;
                entry.target.classList.add('is-in');
                io.unobserve(entry.target);
              }
            },
            { threshold: 0.12, rootMargin: '0px 0px -6% 0px' },
          );
          root.classList.add('js');
          for (const el of items) {
            el.dataset.reveal = '';
            el.style.setProperty('--reveal-delay', `${revealDelay(Math.max(0, seen.get(el) ?? 0))}s`);
            io.observe(el);
          }
        } catch {
          root.classList.remove('js');
        }
      }
    </script>
  </body>
</html>

<style is:global>
  .night-top { background: var(--night); color: var(--on-night); }
</style>
