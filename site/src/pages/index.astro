---
import { Image } from 'astro:assets';
import Button from '../components/Button.astro';
import heroPhoto from '../assets/home/hero.jpg';
import appScreen from '../assets/app/screen.png';
import HtrAvatar from '../components/HtrAvatar.astro';
import IphoneFrame from '../components/IphoneFrame.astro';
import HybridLogWordmark from '../components/HybridLogWordmark.astro';
import { SITE } from '../config.ts';
import Base from '../layouts/Base.astro';
import { loadArticles } from '../lib/collection.ts';
import RubricNav from '../components/RubricNav.astro';
import ArticleList from '../components/ArticleList.astro';

const basics = [
  { dots: ['#1D46E8', '#3091D8'], tag: 'Баланс', title: 'Сила и кардио', text: '2–3 силовых и 2–3 кардио в цикл. Отдельные тренировки сочетают оба режима.' },
  { dots: ['#3091D8'], tag: 'Упражнения', title: 'Разнообразие', text: 'Вместо сплита по группам мышц — бег, гребля и SkiErg, присед, становая и жимы в одной системе.' },
  { dots: ['#1D46E8'], tag: 'Разные нагрузки', title: 'Тяжело и мало или легко и много', text: 'Силовые дни — большие веса на малое число повторений, скоростные — спринты и лёгкие веса на много повторений. Спринты и долгие забеги.' },
  { dots: ['#7D8796'], tag: 'Интенсивность', title: 'Продуманное чередование', text: 'Спринт во вторник и присед в пятницу лучше, чем спринт и присед подряд: нервная система успевает восстановиться.' },
  { dots: ['#3091D8', '#1D46E8'], tag: 'Циклы', title: 'Циклы по 12–16 недель', text: 'Программы охватывают выносливость, силу и функциональные навыки, объём и интенсивность растут постепенно.' },
  { dots: ['#7D8796'], tag: 'Восстановление', title: 'Отдых — часть программы', text: 'Сон, вода, питание и мобильность прописаны как часть плана. Техника важнее скорости, особенно на усталости.' },
];

const fresh = (await loadArticles()).slice(0, 3);

const appPoints = [
  { color: '#1D46E8', text: 'Любая тренировка: зал, площадка, бег, вело, комплексы' },
  { color: '#3091D8', text: 'Готовые программы и каталог комплексов' },
  { color: '#E2591A', text: 'Прогресс по силе и выносливости' },
  { color: '#7D8796', text: 'Импорт ваших тренировок' },
];
---

<Base>
  <Fragment slot="hero">
    <section class="hero wrap">
      <div class="hero__text">
        <span class="hero__kicker">{SITE.tagline}</span>
        <h1 class="hero__title">
          Hybrid<br />Training<br />Russia
        </h1>
        <p class="hero__lead">Комьюнити увлечённых здоровыми и разнообразными тренировками</p>
        <div class="hero__actions">
          <Button href="/articles/" variant="sky" size="lg">Статьи</Button>
          <Button href="/app/" variant="outline" size="lg">Приложение</Button>
        </div>
      </div>
      <div class="hero__photo">
        <Image src={heroPhoto} alt="Бегун на вечерней тренировке" widths={[480, 800, 1200]} sizes="(max-width: 900px) 100vw, 40vw" loading="eager" fetchpriority="high" />
      </div>
    </section>

  </Fragment>

  <section class="section wrap" aria-labelledby="basics-title">
    <div class="section__head">
      <span class="label">Основы</span>
      <h2 id="basics-title" class="h2">Что такое гибридная тренировка</h2>
    </div>
    <div class="basics">
      {basics.map((b) => (
        <article class="basic">
          <span class="basic__tag">
            {b.dots.map((c, i) => <span class="basic__dot" style={`background:${c}${i > 0 ? ';margin-left:-4px' : ''}`}></span>)}
            {b.tag}
          </span>
          <h3 class="basic__title">{b.title}</h3>
          <p class="basic__text">{b.text}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section wrap" aria-labelledby="fresh-title">
    <div class="section__row">
      <h2 id="fresh-title" class="h2">Свежие статьи</h2>
      <RubricNav current={null} />
    </div>
    <ArticleList articles={fresh} empty="Статей пока нет. Первые появятся совсем скоро." />
  </section>

  <section class="section wrap" aria-labelledby="app-title">
    <div class="app">
      <div class="app__text">
        <div class="app__brand">
          <HybridLogWordmark />
          <span class="app__soon">Скоро</span>
        </div>
        <h2 id="app-title" class="app__title">Силовые и кардио в одном месте</h2>
        <ul class="app__list">
          {appPoints.map((p) => <li><span class="app__bullet" style={`background:${p.color}`}></span>{p.text}</li>)}
        </ul>
        <Button href="/app/" variant="cobalt">Узнать о HybridLog</Button>
      </div>
      <div class="app__phone-wrap">
        <IphoneFrame src={appScreen} alt="Экран «Прогресс» в приложении HybridLog" />
      </div>
    </div>
  </section>

  <section class="section section--last wrap" aria-labelledby="insta-title">
    <div class="insta">
      <div class="insta__who">
        <HtrAvatar />
        <div class="insta__text">
          <h2 id="insta-title" class="insta__title">Комьюнити</h2>
          <p class="insta__lead">Программы, комплексы и разборы тренировок — {SITE.instagramHandle}</p>
        </div>
      </div>
      <Button href={SITE.instagramUrl} variant="cobalt">Подписаться</Button>
    </div>
  </section>
</Base>

<style>
  .hero { display: flex; flex-wrap: wrap; align-items: stretch; gap: 48px; padding-block: 40px 72px; }
  .hero__text { flex: 1 1 540px; min-width: 0; display: flex; flex-direction: column; justify-content: center; gap: 28px; }
  .hero__kicker { font: 500 13px/1.3 var(--font-data); letter-spacing: 0.08em; text-transform: uppercase; color: var(--on-night-muted); }
  .hero__title { margin: 0; font: 700 clamp(56px, 9vw, 136px) / 0.94 var(--font-display); letter-spacing: 0.005em; text-transform: uppercase; }
  .hero__lead { margin: 0; max-width: 520px; font-size: 19px; line-height: 1.55; color: var(--on-night-soft); }
  .hero__actions { display: flex; flex-wrap: wrap; gap: 12px; }
  .hero__photo { flex: 1 1 360px; min-width: 0; position: relative; min-height: 540px; border-radius: 28px; background: var(--night-panel); overflow: hidden; }
  .hero__photo :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 55% 40%; }

  .section { padding-top: 88px; display: flex; flex-direction: column; gap: 32px; }
  .section--last { padding-bottom: 88px; }
  .section__head { display: flex; flex-direction: column; gap: 12px; }
  .section__row { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 16px; }
  .h2 { margin: 0; font: 700 clamp(28px, 3.8vw, 48px) / 1.02 var(--font-display); letter-spacing: 0.01em; text-transform: uppercase; }

  .basics { display: flex; flex-wrap: wrap; gap: 20px; }
  .basic { flex: 1 1 300px; min-width: 0; border: 1px solid var(--line); border-radius: 16px; padding: 28px; display: flex; flex-direction: column; gap: 14px; }
  .basic__tag { display: inline-flex; align-items: center; gap: 8px; align-self: flex-start; font: 500 12px/1.3 var(--font-data); letter-spacing: 0.08em; text-transform: uppercase; }
  .basic__dot { width: 10px; height: 10px; border-radius: 999px; display: inline-block; }
  .basic__title { margin: 0; font: 600 22px/1.2 var(--font-display); }
  .basic__text { margin: 0; color: var(--ink-muted); font-size: 16px; line-height: 1.5; }


  .app { background: var(--surface); border-radius: 28px; padding: clamp(28px, 5vw, 64px); display: flex; flex-wrap: wrap; align-items: center; gap: 48px; }
  .app__text { flex: 1 1 440px; min-width: 0; display: flex; flex-direction: column; gap: 22px; align-items: flex-start; }
  .app__brand { display: flex; align-items: center; gap: 14px; }
  .app__soon { padding: 4px 12px 5px; border-radius: 999px; background: #fff; box-shadow: 0 0 0 2px var(--night) inset; font-weight: 600; font-size: 14px; transform: rotate(3deg); }
  .app__title { margin: 0; font: 700 clamp(26px, 3.4vw, 44px) / 1.05 var(--font-display); letter-spacing: 0.01em; text-transform: uppercase; }
  .app__list { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 12px; font-size: 18px; line-height: 1.4; }
  .app__list li { display: flex; gap: 12px; align-items: baseline; }
  .app__bullet { flex: none; width: 11px; height: 11px; border-radius: 999px; }
  .app__phone-wrap { flex: 1 1 320px; min-width: 0; display: flex; justify-content: center; }

  .insta { border: 1px solid var(--line); border-radius: 28px; padding: clamp(24px, 4vw, 44px); display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 28px; }
  .insta__who { display: flex; flex-wrap: wrap; align-items: center; gap: 24px; min-width: 0; }
  .insta__text { display: flex; flex-direction: column; gap: 6px; min-width: 0; }
  .insta__title { margin: 0; font: 700 clamp(22px, 2.6vw, 34px) / 1.1 var(--font-display); letter-spacing: 0.01em; text-transform: uppercase; }
  .insta__lead { margin: 0; font-size: 17px; color: var(--ink-muted); }

  @media (max-width: 640px) {
    .hero { padding-block: 24px 48px; gap: 32px; }
    .hero__photo { min-height: 360px; }
    .section { padding-top: 56px; }
    .section--last { padding-bottom: 56px; }
  }
</style>
