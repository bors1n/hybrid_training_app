---
import type { GetStaticPaths } from 'astro';
import ArticleList from '../../components/ArticleList.astro';
import RubricNav from '../../components/RubricNav.astro';
import Base from '../../layouts/Base.astro';
import { RUBRICS, rubricLabel, type RubricKey } from '../../lib/articles.ts';
import { loadArticles } from '../../lib/collection.ts';

export const getStaticPaths = (() => RUBRICS.map((r) => ({ params: { rubric: r.key } }))) satisfies GetStaticPaths;

const key = Astro.params.rubric as RubricKey;
const label = rubricLabel(key);
const articles = await loadArticles(key);
---

<Base title={label} description={`Статьи рубрики «${label}»`} headerOnNight={false}>
  <section class="page wrap">
    <div class="page__head">
      <span class="label">Рубрика</span>
      <h1 class="page__title">{label}</h1>
    </div>
    <RubricNav current={key} />
    <ArticleList articles={articles} empty={`В рубрике «${label}» пока нет статей.`} />
  </section>
</Base>

<style>
  .page { padding-block: 56px 96px; display: flex; flex-direction: column; gap: 28px; }
  .page__head { display: flex; flex-direction: column; gap: 12px; }
  .page__title { margin: 0; font: 700 clamp(40px, 6vw, 76px) / 0.98 var(--font-display); letter-spacing: 0.005em; text-transform: uppercase; }
</style>
