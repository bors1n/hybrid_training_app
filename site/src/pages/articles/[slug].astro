---
import type { GetStaticPaths } from 'astro';
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import ArticleList from '../../components/ArticleList.astro';
import Button from '../../components/Button.astro';
import Base from '../../layouts/Base.astro';
import { formatDate, isoDate, rubricLabel, rubricPath } from '../../lib/articles.ts';
import { loadArticles } from '../../lib/collection.ts';

export const getStaticPaths = (async () => {
  const articles = await loadArticles();
  return articles.map((a) => ({
    params: { slug: a.slug },
    props: { article: a, more: articles.filter((x) => x.slug !== a.slug && x.rubric === a.rubric).slice(0, 3) },
  }));
}) satisfies GetStaticPaths;

const { article, more } = Astro.props;
const { Content } = await render(article.entry);
---

<Base title={article.title} description={article.lead} headerOnNight={false}>
  <article class="article">
    <header class="article__head wrap">
      <a class="article__rubric" href={rubricPath(article.rubric)}>{rubricLabel(article.rubric)}</a>
      <h1 class="article__title">{article.title}</h1>
      <p class="article__lead">{article.lead}</p>
      <p class="article__meta">
        <time datetime={isoDate(article.date)}>{formatDate(article.date)}</time>
        <span aria-hidden="true">·</span>
        <span>{article.readingMin} мин чтения</span>
      </p>
    </header>

    {article.cover ? <div class="article__cover wrap"><Image src={article.cover} alt="" widths={[680, 1240]} sizes="(max-width: 1280px) 100vw, 1240px" loading="eager" /></div> : null}

    <div class="article__body wrap">
      <div class="prose"><Content /></div>
    </div>

    <aside class="article__cta wrap" aria-label="Приложение HybridLog">
      <div class="cta">
        <p class="cta__text">Ведите силовые, бег и комплексы в одном дневнике.</p>
        <Button href="/app/" variant="cobalt">Узнать о HybridLog</Button>
      </div>
    </aside>
  </article>

  {
    more.length > 0 ? (
      <section class="more wrap" aria-labelledby="more-title">
        <h2 id="more-title" class="more__title">Ещё в рубрике «{rubricLabel(article.rubric)}»</h2>
        <ArticleList articles={more} empty="" />
      </section>
    ) : null
  }
</Base>

<style>
  .article { padding-block: 56px 0; display: flex; flex-direction: column; gap: 36px; }
  /* Заголовок, текст и призыв — одна колонка 680 px по центру (внутренние поля .wrap входят в ширину). */
  .article__head, .article__body, .article__cta { width: 100%; max-width: calc(680px + 2 * var(--site-pad)); margin-inline: auto; }
  .article__head { display: flex; flex-direction: column; gap: 16px; align-items: flex-start; }
  .article__rubric { padding: 4px 12px; border-radius: 8px; background: var(--sky); color: var(--night); font-weight: 600; font-size: 14px; text-decoration: none; min-height: 32px; display: inline-flex; align-items: center; }
  .article__rubric:hover { background: var(--night); color: #fff; }
  .article__title { margin: 0; font: 700 clamp(32px, 5vw, 56px) / 1.02 var(--font-display); letter-spacing: 0.005em; }
  .article__lead { margin: 0; font-size: 21px; line-height: 1.5; color: var(--ink-muted); }
  .article__meta { margin: 0; display: flex; gap: 8px; font: 500 13px/1.3 var(--font-data); color: var(--ink-muted); }
  .article__cover { width: 100%; }
  .article__cover :global(img) { display: block; width: 100%; height: auto; aspect-ratio: 2 / 1; border-radius: 20px; object-fit: cover; object-position: 50% 45%; }

  .prose { font-size: 19px; line-height: 1.65; }
  .prose :global(p) { margin: 0 0 1.2em; }
  .prose :global(h2) { margin: 2em 0 0.7em; font: 700 clamp(24px, 3vw, 32px) / 1.15 var(--font-display); letter-spacing: 0.005em; }
  .prose :global(h3) { margin: 1.6em 0 0.5em; font: 600 22px / 1.2 var(--font-display); }
  .prose :global(strong) { font-weight: 600; }
  .prose :global(ul), .prose :global(ol) { margin: 0 0 1.2em; padding-left: 1.3em; }
  .prose :global(li) { margin-bottom: 0.4em; }
  .prose :global(blockquote) { margin: 1.6em 0; padding: 20px 24px; border-radius: 16px; background: var(--surface); }
  .prose :global(blockquote p) { margin: 0; }
  .prose :global(a) { color: var(--cobalt); }
  .prose :global(img) { height: auto; border-radius: 16px; }
  .prose :global(table) { width: 100%; border-collapse: collapse; display: block; overflow-x: auto; font-size: 16px; }
  .prose :global(th), .prose :global(td) { text-align: left; padding: 8px 12px 8px 0; border-bottom: 1px solid var(--line); }
  .prose :global(code) { font-family: var(--font-data); font-size: 0.9em; background: var(--surface); padding: 2px 6px; border-radius: 6px; }

  .cta { background: var(--surface); border-radius: 28px; padding: 28px; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 20px; }
  .cta__text { margin: 0; font: 600 18px/1.35 var(--font-text); max-width: 360px; }

  .more { padding-top: 72px; display: flex; flex-direction: column; gap: 24px; }
  .more__title { margin: 0; font: 700 clamp(24px, 3vw, 32px) / 1.1 var(--font-display); letter-spacing: 0.005em; }
  .article + .more { padding-bottom: 0; }
  :global(main) { padding-bottom: 88px; }
</style>
