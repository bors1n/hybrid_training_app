# /etc/caddy/Caddyfile. Сертификаты Caddy выпускает и продлевает сам (Let's Encrypt),
# для этого DNS-записи @, www и app должны указывать на сервер, а порты 80 и 443 быть открыты.

# Сайт Hybrid Training Russia: статика Astro.
hybridtraining.ru {
	root * /srv/hybridlog/site
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=15552000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
	@hashed path /_astro/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	file_server
}

www.hybridtraining.ru {
	redir https://hybridtraining.ru{uri} permanent
}

# Приложение HybridLog: клиент (PWA) и API на одном origin.
app.hybridtraining.ru {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=15552000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	handle /api/* {
		reverse_proxy 127.0.0.1:8787
	}

	handle {
		root * /srv/hybridlog/client
		# Файлы с хэшем в имени кэшируются навсегда; служебные всегда перепроверяются,
		# иначе телефон не увидит новую версию приложения.
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@fresh path /index.html /sw.js /registerSW.js /manifest.webmanifest /workbox-*.js
		header @fresh Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
