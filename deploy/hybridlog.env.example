# Копия лежит на сервере в /etc/hybridlog.env (chmod 600, владелец root). В git секреты не попадают.
NODE_ENV=production
PORT=8787
# Длинная случайная строка: openssl rand -hex 32. После смены все коды входа становятся недействительными.
AUTH_SECRET=
# Сервер стоит за Caddy: лимиты запросов считаются по реальному IP.
TRUST_PROXY=1
DATABASE_FILE=/var/lib/hybridlog/hybridlog.db
# Почта для кодов входа. Пока не задана, коды печатаются в журнал сервера (journalctl -u hybridlog).
# Пример: smtps://логин:пароль@smtp.example.com:465
SMTP_URL=
MAIL_FROM=HybridLog <no-reply@hybridtraining.ru>
# Копия базы вне сервера (rsync): user@host:/path/. Пусто — копии только на этом сервере.
BACKUP_REMOTE=
